{
  "name": "tallyfold",
  "owner": {
    "name": "swiftugandan",
    "url": "https://github.com/swiftugandan"
  },
  "description": "Tallyfold: memory your agents keep across sessions and projects, in a private git repo you own.",
  "plugins": [
    {
      "name": "tallyfold",
      "source": "./plugin",
      "description": "Memory your agents keep across sessions and projects, in a private git repo you own.",
      "version": "0.1.0",
      "homepage": "https://swiftugandan.github.io/tallyfold/",
      "repository": "https://github.com/swiftugandan/tallyfold",
      "license": "MIT",
      "keywords": ["memory", "git", "mcp"],
      "strict": false,
      "mcpServers": "./com.anthropic.claude-code/mcp.json",
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/bin/tallyfold hook session-start",
                "timeout": 30
              }
            ]
          }
        ]
      }
    }
  ]
}
